# docker compose 环境变量示例：复制为 .env 后按需修改

# 宿主机映射端口（容器内固定 5612）
SEKIRO_HTTP_PORT=5612

# /op 监控密码；空 = 不启用登录保护（公网部署建议设置）
OP_PASSWORD=

# 容器硬内存限制与 Go GC 软目标。GOMEMLIMIT 不是硬限制，不能修复泄漏。
SEKIRO_MEM_LIMIT=4g
GOMEMLIMIT=3GiB
GOGC=100

# 可选：日志级别 debug/info/warn/error，生产可用 warn 关闭逐笔调用日志
# SEKIRO_LOG_LEVEL=info

# 可选：关闭 /op 页面与全部 /op/api/*
# SEKIRO_OP_DISABLE=false

# 外部直连 TLS 证书需额外挂载进容器，通常由 nginx/Caddy 终结 TLS，
# 因此 compose 默认不透传 SEKIRO_TLS_*。
